<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:keep="@xml/clipboardplugin_preferences">

    <SwitchPreference
        android:defaultValue="false"
        android:key="@string/clipboard_preference_key_skip_sensitive"
        android:summary="@string/clipboard_preference_summary_skip_sensitive"
        android:title="@string/clipboard_preference_title_skip_sensitive" />

    <PreferenceCategory
        android:title="@string/clipboard_preference_category_image_sync">

        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/clipboard_preference_key_image_size_limit_enabled"
            android:summary="@string/clipboard_preference_summary_image_size_limit"
            android:title="@string/clipboard_preference_title_image_size_limit" />

        <SeekBarPreference
            android:defaultValue="1"
            android:key="@string/clipboard_preference_key_max_image_size_mb"
            android:max="10"
            android:summary="@string/clipboard_preference_summary_max_image_size_mb"
            android:title="@string/clipboard_preference_title_max_image_size_mb"
            app:min="0"
            app:showSeekBarValue="true" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
